NEXT_PUBLIC_VERCEL_ENV=production
NEXT_PUBLIC_GTM=your_google_tag_manager_id
# Contact form (https://resend.com). Without a verified domain, Resend only delivers
# from onboarding@resend.dev to the email address of the Resend account.
RESEND_API_KEY=your_resend_api_key
# Optional, requires a domain verified in Resend, e.g. "Portfolio <contact@your-domain.com>"
CONTACT_FROM_EMAIL=
